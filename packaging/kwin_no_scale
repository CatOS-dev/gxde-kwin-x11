#!/bin/sh
# startdde waits for this launcher to exit before starting the desktop.
export QT_QPA_PLATFORM=xcb

if [ -z "${DDE_SESSION_PROCESS_COOKIE_ID:-}" ]; then
    exec /usr/bin/gxde-kwin_x11 "$@"
fi

# KWin is not a Deepin session-cookie client. Keep it running in the
# login session, and return once it claims the X11 window manager role.
# startdde's existing process waiter then releases the remaining startup.
unset DDE_SESSION_PROCESS_COOKIE_ID
wm_window() {
    xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null \
        | sed -n 's/.*window id # \(0x[0-9a-fA-F]*\).*/\1/p'
}
previous_wm_window=$(wm_window)
/usr/bin/gxde-kwin_x11 "$@" &
kwin_pid=$!

tries=0
while [ "$tries" -lt 100 ] && kill -0 "$kwin_pid" 2>/dev/null; do
    current_wm_window=$(wm_window)
    owner_pid=$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus GetConnectionUnixProcessID s org.kde.KWin 2>/dev/null)
    if [ -n "$current_wm_window" ] && [ "$current_wm_window" != "$previous_wm_window" ] \
        && [ "$owner_pid" = "u $kwin_pid" ]; then
        exit 0
    fi
    sleep 0.1
    tries=$((tries + 1))
done

if ! kill -0 "$kwin_pid" 2>/dev/null; then
    wait "$kwin_pid"
else
    echo 'kwin_no_scale: KWin did not become the X11 window manager' >&2
fi
exit 1
